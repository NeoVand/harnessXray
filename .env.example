# Local development convenience only.
#
# Copy to `.env` and add your own key. `.env` is gitignored.
#
# This is read through `import.meta.env.DEV`, which Vite replaces with `false`
# in a production build — so the branch is dead-code-eliminated and the key
# never reaches shipped output. In production the only key is the one a user
# types into the settings sheet, which is held in their own browser.
VITE_OPENAI_API_KEY=sk-proj-...
